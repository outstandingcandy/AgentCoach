[Unit]
Description=GoalInsight web app (FastAPI viewer + Bedrock chat)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/AgentCoach
# Daemonised form of deploy/start_web.sh. Bound to 0.0.0.0:8000 so the ALB
# can reach it; the instance security group only exposes :8000 to the ALB's
# SG (never the public internet — SSH 22 is the only externally-open port).
# Chat is left enabled (no GOALINSIGHT_DISABLE_CHAT), so the instance role
# must grant Bedrock access. Region is us-east-1 (hardcoded in chat.py).
Environment=AWS_REGION=us-east-1
Environment=PYTHONUNBUFFERED=1
# Optional video offload to S3/CloudFront — uncomment and fill in to match
# deploy/start_web.sh's behaviour:
#Environment=GOALINSIGHT_VIDEO_S3_BUCKET=
#Environment=GOALINSIGHT_VIDEO_CLOUDFRONT_DOMAIN=
#Environment=GOALINSIGHT_VIDEO_CF_KEY_PAIR_ID=
#Environment=GOALINSIGHT_VIDEO_CF_PRIVATE_KEY_PATH=/home/ubuntu/AgentCoach/deploy/cloudfront/cf_private.pem
ExecStart=/home/ubuntu/AgentCoach/.venv/bin/python -m goalinsight.web \
    --workspace /home/ubuntu/AgentCoach/workspace \
    --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
# The pipeline subprocess can be memory-hungry; give it generous headroom.
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
