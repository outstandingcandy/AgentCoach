[Unit]
Description=GoalInsight web app (containerized: FastAPI viewer + Bedrock chat)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
# Runs the deployment image (built on-instance by ec2_userdata.sh) as a
# foreground container systemd can supervise. The bind-mounted workspace
# holds videos, runs, and downloaded model weights so they survive
# container recreation. Bound to 0.0.0.0:8000 for the ALB; the instance
# SG only exposes :8000 to the ALB's SG (SSH 22 is the only public port).
# Chat is enabled (no GOALINSIGHT_DISABLE_CHAT), so the instance role must
# grant Bedrock access. Region is us-east-1 (hardcoded in chat.py).
Type=simple
# Clear any stale container from a previous boot before starting.
ExecStartPre=-/usr/bin/docker rm -f goal-insight-web
ExecStart=/usr/bin/docker run --rm --name goal-insight-web \
    --gpus all \
    -p 8000:8000 \
    -v /home/ubuntu/AgentCoach/workspace:/workspace \
    -e AWS_REGION=us-east-1 \
    goalinsight:deploy
ExecStop=/usr/bin/docker stop goal-insight-web
Restart=always
RestartSec=5
# First boot pulls model weights inside the container start path; give it room.
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
