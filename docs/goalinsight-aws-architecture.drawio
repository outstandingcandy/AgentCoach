          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="step-6-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Auto-sync outputs to S3&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Everything under /opt/ml/processing/output/&amp;lt;stage&amp;gt;/ is auto-synced to s3://&amp;lt;bucket&amp;gt;/pipeline-runs/&amp;lt;run-id&amp;gt;/&amp;lt;stage&amp;gt;/ when the job ends.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-6-legend">
          <mxGeometry height="100" width="548" x="52" as="geometry" />
