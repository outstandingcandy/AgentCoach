          <mxGeometry height="80" width="548" x="52" as="geometry" />
        </mxCell>

        <!-- Step 9 -->
        <mxCell id="step-9-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container">
          <mxGeometry height="70" width="600" x="0" y="744" as="geometry" />
        </mxCell>
        <mxCell id="step-9-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="9" vertex="1" parent="step-9-legend">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="step-9-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Hosted on AgentCore Runtime &lt;i&gt;(planned)&lt;/i&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Move ChatEngine.stream off the local FastAPI process onto AgentCore Runtime. Runtime owns the tool_use loop, prompt cache breakpoints, session memory, and SSE stream back to the browser. Today this all runs in-process on the workstation (dashed grey edge).&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-9-legend">
          <mxGeometry height="140" width="548" x="52" as="geometry" />
        </mxCell>

        <!-- Step 10 -->
        <mxCell id="step-10-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container">
