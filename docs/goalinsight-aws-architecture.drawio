        </mxCell>
        <mxCell id="step-11-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="11" vertex="1" parent="step-11-legend">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="step-11-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Tool dispatch&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;list_events / get_player_stats / get_team_stats / get_frame_snapshot run against MatchContext. run_python is the only tool that leaves the host — it forwards to AgentCore Code Interpreter.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-11-legend">
          <mxGeometry height="120" width="548" x="52" as="geometry" />
        </mxCell>

        <!-- Step 12 -->
        <mxCell id="step-12-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container">
          <mxGeometry height="70" width="600" x="0" y="1056" as="geometry" />
        </mxCell>
        <mxCell id="step-12-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="12" vertex="1" parent="step-12-legend">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="step-12-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Run Python in Code Interpreter sandbox&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;CodeSandbox starts a Code Interpreter session (aws.codeinterpreter.v1), lazily uploads ./data/*.json, executes the LLM's code, and returns plot artifacts whose URLs stream back to the chat UI as inline images.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-12-legend">
          <mxGeometry height="120" width="548" x="52" as="geometry" />
        </mxCell>

        <!-- Line styles legend -->
        <mxCell id="line-styles-bg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;verticalAlign=top;fontStyle=1;fontSize=12;fontFamily=Helvetica;fontColor=light-dark(#16191F,#FFFFFF);spacingTop=8;spacingLeft=10;align=left;" value="&lt;b&gt;Line styles&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px;&quot;&gt;solid: control + data flow · long-dash teal: planned future state · short-dash teal: current FastAPI fallback · dashed red: IAM trust&lt;/span&gt;" vertex="1" parent="legend-container">
          <mxGeometry x="0" y="1190" width="600" height="60" as="geometry" />
